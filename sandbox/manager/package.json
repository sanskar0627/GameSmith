{
  "name": "gamesmith-sandbox-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Starts, stops and proxies GameSmith game sandboxes. The only service with access to the Docker socket.",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run"
  },
  "dependencies": {
    "dockerode": "5.0.1",
    "tar-stream": "3.2.2"
  },
  "devDependencies": {
    "@types/dockerode": "4.0.2",
    "@types/node": "22.20.5",
    "@types/tar-stream": "3.1.5",
    "@types/ws": "^8.18.2",
    "typescript": "5.9.3",
    "vite": "8.3.4",
    "vitest": "5.0.3",
    "ws": "8.22.0"
  }
}
