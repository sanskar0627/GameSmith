{
  "name": "gamesmith",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node --conditions=react-server --import tsx worker/main.mts",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:up": "docker compose --env-file .env.local up -d --wait postgres",
    "db:down": "docker compose --env-file .env.local --profile sandbox down",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "redis:up": "docker compose --env-file .env.local up -d --wait redis",
    "sandbox:install": "npm --prefix sandbox/manager ci && npm --prefix sandbox/template/files ci",
    "sandbox:test": "npm --prefix sandbox/manager test",
    "sandbox:build": "docker compose --env-file .env.local --profile build --profile sandbox build sandbox-image sandbox-manager",
    "sandbox:up": "docker compose --env-file .env.local --profile sandbox up -d --wait sandbox-manager sandbox-proxy",
    "sandbox:down": "docker compose --env-file .env.local --profile sandbox stop sandbox-manager sandbox-proxy",
    "sandbox:smoke": "node --env-file=.env.local sandbox/smoke.mjs"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "^4.0.78",
    "@ai-sdk/fal": "^3.0.59",
    "@ai-sdk/openai": "^4.0.91",
    "@base-ui/react": "^1.8.0",
    "@clerk/nextjs": "^7.9.10",
    "@clerk/ui": "^1.38.1",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-html": "^6.4.12",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-json": "^6.0.2",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.13.1",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.14",
    "@lezer/highlight": "^1.2.5",
    "@openrouter/ai-sdk-provider": "^3.1.0",
    "@polar-sh/sdk": "^1.0.2",
    "@shadcn/react": "^0.3.1",
    "ai": "^7.0.137",
    "bullmq": "^6.3.15",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "codemirror": "^6.0.2",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.4",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "ioredis": "^6.0.0",
    "lucide-react": "^1.51.0",
    "next": "16.3.8",
    "postgres": "^3.4.9",
    "react": "19.2.8",
    "react-day-picker": "^10.0.2",
    "react-dom": "19.2.8",
    "react-resizable-panels": "^4.14.2",
    "recharts": "^3.8.0",
    "server-only": "^0.0.1",
    "shadcn": "^4.21.1",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@next/env": "16.3.8",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.3"
  },
  "engines": {
    "node": ">=22.12"
  }
}
