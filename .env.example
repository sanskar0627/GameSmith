# Copy to .env.local and fill in. Never commit real values.

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/games
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/games

# Clerk webhook signing secret (Dashboard -> Webhooks -> endpoint -> Signing secret).
# Optional in local dev: users are also synced on first visit to the app.
CLERK_WEBHOOK_SIGNING_SECRET=

# Postgres. `npm run db:up` starts it with this password; the app and the tests
# build the local connection URL from it. Pick any random string, e.g. `openssl rand -hex 16`.
POSTGRES_PASSWORD=

# Optional: set these only to use a different database than the local one.
# DATABASE_URL=postgres://gamesmith:<password>@localhost:5432/gamesmith

# Used by `npm test` only. Defaults to the local gamesmith_test database.
# TEST_DATABASE_URL=postgres://gamesmith:<password>@localhost:5432/gamesmith_test

# Absolute site URL, used for Open Graph images in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Encrypts users' saved API keys (AES-256-GCM). Required in production.
# Generate:  node -e "console.log('1:' + require('crypto').randomBytes(32).toString('base64'))"
# Rotate: put the new entry first, keep old ones after it: 2:<new>,1:<old>
KEY_ENCRYPTION_KEYS=

# Platform AI keys. Models paid with sparks run on these. All optional:
# models from a provider without a key are offered with the user's own key only.
PLATFORM_ANTHROPIC_API_KEY=
PLATFORM_OPENAI_API_KEY=
PLATFORM_OPENROUTER_API_KEY=
PLATFORM_FAL_KEY=

# Payments through Polar (https://polar.sh). Optional locally.
# Organization access token, webhook secret (endpoint: <app url>/api/webhooks/polar,
# events: order.paid, order.refunded, subscription.*), and one product per offer.
POLAR_SERVER=sandbox
POLAR_ACCESS_TOKEN=
POLAR_WEBHOOK_SECRET=
POLAR_PRODUCT_FORGE=
POLAR_PRODUCT_STUDIO=
POLAR_PRODUCT_PACK_5K=
POLAR_PRODUCT_PACK_25K=

# Redis (`npm run redis:up`): the agent queue and live run events.
REDIS_PASSWORD=
# Optional locally (built from REDIS_PASSWORD). Required in production.
# REDIS_URL=redis://:<password>@127.0.0.1:6379

# Where agent runs execute. "inline" (development default): inside `npm run dev`,
# no worker needed. "redis" (production default): BullMQ queue + `npm run worker`.
# AGENT_QUEUE=inline
# Runs one worker process handles at a time.
# AGENT_CONCURRENCY=4

# Game sandboxes (see sandbox/README.md). Optional: without them the sandbox
# endpoints answer "not set up". Generate the token with `openssl rand -hex 32`.
SANDBOX_MANAGER_TOKEN=
SANDBOX_MANAGER_URL=http://127.0.0.1:4100
SANDBOX_PREVIEW_ORIGIN=http://127.0.0.1:4101
# runc locally (Docker Desktop has no gVisor); runsc + true on the VM.
SANDBOX_RUNTIME=runc
SANDBOX_REQUIRE_GVISOR=false
