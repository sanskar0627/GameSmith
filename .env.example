# Copy to .env.local and fill in. Never commit real values.

# Clerk (https://dashboard.clerk.com -> API keys)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/games
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/games

# Clerk webhook signing secret (Dashboard -> Webhooks -> endpoint -> Signing secret).
# Optional in local dev: users are also synced on first visit to the app.
CLERK_WEBHOOK_SIGNING_SECRET=

# Postgres (matches compose.yml)
DATABASE_URL=postgres://gamesmith:gamesmith@localhost:5432/gamesmith

# Used by `npm test` only. Defaults to this value when unset.
TEST_DATABASE_URL=postgres://gamesmith:gamesmith@localhost:5432/gamesmith_test

# Absolute site URL, used for Open Graph images in production.
NEXT_PUBLIC_APP_URL=http://localhost:3000
